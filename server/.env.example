NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/school?retryWrites=true&w=majority
JWT_ACCESS_SECRET=your_long_random_jwt_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=your_long_random_jwt_refresh_secret_at_least_32_chars
CLIENT_ORIGINS=http://localhost:5173,https://your-school-app.vercel.app
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
